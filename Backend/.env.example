NODE_ENV=development
PORT=4000

# เพิ่ม domain จริงตรงนี้ก่อน deploy (เช่น https://yourdomain.com)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ---- Firebase Admin SDK ----
# ตัวเลือก A: ระบุ path ไปที่ไฟล์ service account JSON (แนะนำสำหรับ local dev)
FIREBASE_SERVICE_ACCOUNT_PATH=
# ตัวเลือก B: ใส่ค่าตรงๆ (ใช้เมื่อไม่มีไฟล์ JSON — เช่น VPS/CI)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n<YOUR_PRIVATE_KEY_HERE>\n-----END PRIVATE KEY-----\n

# ต้องเปลี่ยน JWT_SECRET เป็น random string ยาวๆ ก่อน deploy!
# สร้างด้วย: openssl rand -base64 64
JWT_SECRET=dev-only-insecure-secret-change-me

WAQI_API_TOKEN=your-waqi-api-token
OPENWEATHER_API_KEY=your-openweather-api-key
MRC_API_KEY=
ADMIN_EMAILS=your-admin@email.com
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
